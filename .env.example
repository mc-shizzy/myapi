# ─── API principale (Node / index.js) ───
PORT=7860
STREAM_PROXY_URL=https://apii.freehandyflix.online

# ─── Serveur apii (proxy-server.js) — OBLIGATOIRE en prod ───
# PORT=7861
# PROXY_PUBLIC_URL=https://apii.freehandyflix.online
# API_KEY=your-secret-key

# ─── Cloudflare Worker (apiv1) — même clé que apii ───
# wrangler secret put API_KEY

# Backend Northflank : envoyer sur chaque requête vers apii :
#   X-Api-Key: <API_KEY>
# ou Authorization: Bearer <API_KEY>
# Optionnel : X-Forwarded-For: <IP client> pour rate limit par user
